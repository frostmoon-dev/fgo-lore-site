# All optional. Visitors normally add their own key on the Connection page.

# The site owner's own key, offered as "This site's key" on the Connection page.
# Locally it works as-is. On Vercel it is only offered when ACCESS_CODE is set,
# so strangers can't spend your credit.
API_BASE_URL=https://api.openai.com/v1
API_KEY=
DEFAULT_MODEL=
ACCESS_CODE=

# Local server port (npm start)
PORT=3000
